# ============================================================
# 复制成 .env.local 后填写。带 VITE_ 前缀的是非机密的构建期变量，
# 会被内联进前端产物；其余是机密，生产环境用 `wrangler secret put <NAME>` 设置。
# ============================================================

# --- 必填 ---------------------------------------------------

# Neon PostgreSQL 连接串
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# 站点根地址，末尾不要带斜杠。
# 它同时决定 OAuth 回调地址、支付跳转地址、canonical / sitemap 里的绝对 URL。
VITE_APP_URL=http://localhost:3000

# R2 公开自定义域名，可选；末尾不要带斜杠。
# 只有创建并启用 wrangler.toml 的 R2 binding 后才需要填写。
R2_PUBLIC_BASE_URL=

# --- Google 登录 --------------------------------------------
# 在 Google Cloud Console 里把「已授权的重定向 URI」设为：
#   <VITE_APP_URL>/auth-callback
# 注意是 /auth-callback（中划线），不是 /auth/callback。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 支付渠道开关 -------------------------------------------
# 逗号分隔，只填你真正配置好的渠道：stripe,creem,paypal
VITE_PAYMENT_PROVIDERS=stripe

# --- Stripe -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_BASIC_PRICE_ID=
VITE_STRIPE_PRO_PRICE_ID=
VITE_STRIPE_ENTERPRISE_PRICE_ID=

# --- Creem --------------------------------------------------
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
VITE_CREEM_PRODUCT_BASIC=
VITE_CREEM_PRODUCT_PRO=
VITE_CREEM_PRODUCT_ENTERPRISE=

# --- PayPal -------------------------------------------------
# sandbox | live —— 显式声明，不要依赖 NODE_ENV
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 必填，否则 webhook 会被直接拒绝（不配置就跳过验签等于门户大开）
PAYPAL_WEBHOOK_ID=
VITE_PAYPAL_PLAN_BASIC=
VITE_PAYPAL_PLAN_PRO=
VITE_PAYPAL_PLAN_ENTERPRISE=

# --- 邮件 -----------------------------------------------------
# console  本地开发用，不真发信，把链接打到控制台（默认）
# cloudflare  Cloudflare Email Service，需 Workers Paid + 域名接入
# resend      Resend，需 RESEND_API_KEY + 域名验证
MAIL_PROVIDER=console
# 必须是已配好 SPF/DKIM 的域名下的地址，否则会进垃圾箱
MAIL_FROM=SaaS Template <noreply@example.com>
RESEND_API_KEY=

# --- 后台 -----------------------------------------------------
# 管理员名单，逗号分隔。不配则后台对所有人关闭。
ADMIN_EMAILS=
