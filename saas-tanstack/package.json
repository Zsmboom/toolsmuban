{
  "name": "saas-tanstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "build:cf": "vite build",
    "deploy:cf": "wrangler deploy",
    "preview:cf": "wrangler dev",
