{
  "name": "saas-tanstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run build:cf",
    "preview": "vite preview",
    "start": "npm run build:cf && wrangler dev",
    "build:cf": "tsc --noEmit && vite build",
    "deploy:cf": "wrangler deploy",
    "preview:cf": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "types:cf": "wrangler types --env-file=.env.example --include-runtime=false --check",
    "types:cf:generate": "wrangler types --env-file=.env.example --include-runtime=false",
    "type-check": "tsc --noEmit",
    "db:use": "node scripts/db-use.mjs",
    "dev:cf": "npm run build:cf && wrangler dev"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "drizzle-orm": "^0.45.0",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^14.0.0",
    "tailwind-merge": "^2.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
